{
  "name": "bulgarian-werewolf-mafia",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "codex:run": "node scripts/codex-run.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "frontend:e2e": "node scripts/frontend-e2e.mjs",
    "frontend:e2e:cross-browser": "node scripts/frontend-e2e-matrix.mjs",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "visual": "playwright test --config=playwright.config.ts --grep-invert @play-matrix",
    "visual:matrix": "playwright test --config=playwright.config.ts apps/web/__visual__/play-m35.spec.ts --grep @play-matrix",
    "visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "visual:legacy-reference": "node scripts/legacy-visual-reference.mjs",
    "ui:dev": "pnpm --filter @werewolf/ui storybook",
    "ui:build": "pnpm --filter @werewolf/ui build",
    "ui:storybook:build": "pnpm --filter @werewolf/ui build-storybook",
    "check:dict": "tsx scripts/check-dictionary.mjs",
    "visual:ui": "playwright test --config=playwright.ui.config.ts",
    "audit:css": "node scripts/audit-globals-css.mjs",
    "perf:budget": "node --test scripts/bundle-budget.test.mjs && node scripts/bundle-budget.mjs",
    "play:gate": "playwright test --config=playwright.config.ts apps/web/__visual__/play-m35.spec.ts --grep @play-gate",
    "play:interaction": "playwright test --config=playwright.config.ts apps/web/__visual__/play-m35.spec.ts --grep @play-interaction",
    "play:matrix": "playwright test --config=playwright.config.ts apps/web/__visual__/play-m35.spec.ts --grep @play-matrix",
    "loadtest": "node scripts/loadtest.mjs",
    "loadtest:launch": "node scripts/loadtest-launch.mjs",
    "loadtest:heavy": "node scripts/loadtest-heavy.mjs",
    "deploy:drain": "node scripts/deploy-drain.mjs",
    "release:manifest:test": "node --test scripts/release-manifest.test.mjs",
    "operations:test": "node --test scripts/operations-contract.test.mjs scripts/backup-postgres.behavior.test.mjs scripts/colyseus-sdk-patch.test.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check:migrations": "node --test scripts/check-migration-safety.test.mjs && node scripts/check-migration-safety.mjs",
    "smoke": "node scripts/smoke.mjs",
    "playtest": "node scripts/playtest.mjs",
    "optimize:assets": "node scripts/run-asset-generators.mjs",
    "verify:assets": "node --test scripts/asset-digest.test.mjs scripts/run-asset-generators.test.mjs && node scripts/verify-optimized-assets.mjs",
    "optimize:phase-rail": "node scripts/run-asset-generators.mjs --only-phase-rail",
    "regression": "node scripts/regression.mjs",
    "verify": "pnpm verify:assets && pnpm regression && pnpm release:manifest:test && pnpm operations:test && pnpm check:migrations && pnpm typecheck && pnpm build && pnpm smoke && pnpm frontend:e2e && pnpm e2e:auth && pnpm playtest && pnpm test && pnpm visual && pnpm visual:ui && pnpm perf:budget && pnpm audit:prod && pnpm check:dict",
    "verify:heavy": "pnpm verify && pnpm visual:matrix && pnpm test:migrations && pnpm frontend:e2e:cross-browser && pnpm lighthouse && pnpm loadtest:heavy",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "db:generate": "pnpm --filter @werewolf/database db:generate",
    "db:migrate": "pnpm --filter @werewolf/database db:migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@colyseus/loadtest": "^0.16.2",
    "@lhci/cli": "0.15.1",
    "@types/node": "^24.9.1",
    "playwright": "^1.59.1",
    "sharp": "0.35.3",
    "tsx": "4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2"
  }
}
