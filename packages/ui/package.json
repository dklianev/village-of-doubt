{
  "name": "@werewolf/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles/*.css": "./src/styles/*.css",
    "./artifacts": {
      "types": "./dist/primitives/artifacts/index.d.ts",
      "import": "./dist/primitives/artifacts/index.mjs",
      "require": "./dist/primitives/artifacts/index.js"
    },
    "./states": {
      "types": "./dist/states/empty-states.d.ts",
      "import": "./dist/states/empty-states.mjs",
      "require": "./dist/states/empty-states.js"
    }
  },
  "files": ["dist", "src/tokens.css", "src/styles"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "motion": "12.40.0",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "storybook": "10.4.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
