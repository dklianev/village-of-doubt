{
  "name": "@werewolf/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles/*.css": "./src/styles/*.css",
    "./artifacts": {
      "types": "./dist/primitives/artifacts/index.d.ts",
      "import": "./dist/primitives/artifacts/index.js",
      "require": "./dist/primitives/artifacts/index.cjs"
    },
    "./states": {
      "types": "./dist/states/empty-states.d.ts",
      "import": "./dist/states/empty-states.js",
      "require": "./dist/states/empty-states.cjs"
    }
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/styles"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:types",
    "build:js": "tsup && node scripts/preserve-client-boundary.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch --onSuccess \"node scripts/preserve-client-boundary.mjs && pnpm build:types\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/react-vite": "10.5.9",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.9",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
