# Shared
# Keep the four database passwords distinct and URL-encode them in connection URLs.
DB_PASSWORD=replace-with-32-plus-random-admin-chars
MIGRATOR_DB_PASSWORD=replace-with-32-plus-random-migrator-chars
WEB_DB_PASSWORD=replace-with-32-plus-random-web-chars
GAME_DB_PASSWORD=replace-with-32-plus-random-game-chars
# Local pnpm dev compatibility. Production Compose does not pass this admin URL to apps.
DATABASE_URL=postgres://werewolf:replace-with-32-plus-random-admin-chars@localhost:5432/werewolf?application_name=werewolf-local
# Production Compose identities. Use host "postgres" and the encoded matching password.
MIGRATION_DATABASE_URL=postgres://werewolf_migrator:replace-with-32-plus-random-migrator-chars@postgres:5432/werewolf?application_name=werewolf-migrator
WEB_DATABASE_URL=postgres://werewolf_web:replace-with-32-plus-random-web-chars@postgres:5432/werewolf?application_name=werewolf-web
GAME_DATABASE_URL=postgres://werewolf_game:replace-with-32-plus-random-game-chars@postgres:5432/werewolf?application_name=werewolf-game
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace-with-32-plus-random-redis-chars
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_MAXMEMORY=192mb
REDIS_CONTAINER_MEMORY=256m
REDIS_CONTAINER_CPUS=0.25
DATABASE_POOL_MAX=8
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
DATABASE_MAINTENANCE_INTERVAL_MS=3600000
DATABASE_MAINTENANCE_BATCH_SIZE=1000
DATABASE_STALE_LOBBY_HOURS=48
# 0 preserves all completed-game events. Set a reviewed retention window before enabling deletion.
DATABASE_EVENT_RETENTION_DAYS=0
CADDY_CONTAINER_MEMORY=128m
CADDY_CONTAINER_CPUS=0.25
WEB_CONTAINER_MEMORY=768m
WEB_CONTAINER_CPUS=0.75
GAME_CONTAINER_MEMORY=1024m
GAME_CONTAINER_CPUS=1.25
POSTGRES_CONTAINER_MEMORY=1024m
POSTGRES_CONTAINER_CPUS=0.75
POSTGRES_SHARED_MEMORY=128m
POSTGRES_SLOW_QUERY_MS=500
POSTGRES_ROLES_CONTAINER_MEMORY=128m
POSTGRES_ROLES_CONTAINER_CPUS=0.25
MIGRATOR_CONTAINER_MEMORY=512m
MIGRATOR_CONTAINER_CPUS=1.0
# Unique externally routable address per Colyseus replica, without a URL scheme.
# Leave empty for a single game-server process.
COLYSEUS_PUBLIC_ADDRESS=
# Required production key ring, newest version first.
BETTER_AUTH_SECRETS=2:replace-with-new-32-plus-random-chars,1:replace-with-old-32-plus-random-chars
# Keep the pre-rotation key until database maintenance reports zero unversioned
# OAuth tokens. Then remove it and set the retirement sign-off to true.
BETTER_AUTH_SECRET=replace-with-legacy-32-plus-random-chars
BETTER_AUTH_LEGACY_TOKENS_RETIRED=false
GAME_TOKEN_SECRET=replace-with-another-32-plus-random-chars

# Web
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_BETA_BADGE=true

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is a release-CI secret and must not be stored in this file.
STATUS_CACHE_TTL_MS=20000

# Community links (optional). Display "soon" placeholders if unset.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM=Върколак и Мафия <noreply@example.com>
REPORTS_NOTIFY_EMAIL=

# Game server
GAME_SERVER_PORT=2567
# ALLOW_DEV_AUTH=true   # uncomment ONLY for local dev; never set in production
SENTRY_DSN=

# Production deploy
PUBLIC_WEB_DOMAIN=werewolf.example.com
PUBLIC_WS_DOMAIN=ws.werewolf.example.com
CORS_ORIGIN=https://werewolf.example.com
# In production also set:
# BETTER_AUTH_URL=https://werewolf.example.com
# NEXT_PUBLIC_APP_URL=https://werewolf.example.com
# NEXT_PUBLIC_GAME_SERVER_URL=wss://ws.werewolf.example.com
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
RCLONE_REMOTE=
