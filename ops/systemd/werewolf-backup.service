[Unit]
Description=Back up the Werewolf and Mafia PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/werewolf/backup.env
Environment=BACKUP_REQUIRE_FIXED_CONTAINER=1
Environment=BACKUP_DIR=/var/backups/werewolf
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_MAX_AGE_HOURS=8
ExecStart=/usr/local/libexec/werewolf/backup-postgres.sh
ExecStartPost=/usr/local/libexec/werewolf/check-backup-freshness.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadOnlyPaths=/usr/local/libexec/werewolf /etc/werewolf/backup.env
ReadWritePaths=/var/backups/werewolf
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
