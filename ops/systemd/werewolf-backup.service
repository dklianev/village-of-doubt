[Unit]
Description=Back up the Werewolf and Mafia PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=werewolf
Group=werewolf
SupplementaryGroups=docker
WorkingDirectory=/srv/werewolf
EnvironmentFile=/etc/werewolf/production.env
Environment=BACKUP_DIR=/var/backups/werewolf
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_MAX_AGE_HOURS=8
ExecStart=/bin/sh /srv/werewolf/scripts/backup-postgres.sh
ExecStartPost=/bin/sh /srv/werewolf/scripts/check-backup-freshness.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/werewolf
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
