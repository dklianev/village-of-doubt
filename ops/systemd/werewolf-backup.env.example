# Must match the Compose project that owns the postgres service.
# Existing installations: adopt the current project, never rename it here.
COMPOSE_PROJECT_NAME=werewolf
POSTGRES_USER=werewolf
POSTGRES_DB=werewolf
BACKUP_AGE_RECIPIENT=age1replace_with_the_public_backup_recipient
BACKUP_RELEASE_ALLOWED_IMAGE_PREFIX=ghcr.io/dklianev/village-of-doubt

# Required production destinations: separate named profiles, non-root prefixes.
# The ledger profile must prohibit deletion and retain object version history.
RCLONE_REMOTE=
RCLONE_DELETION_LEDGER_REMOTE=
RCLONE_BACKUP_RETENTION_DAYS=30
RCLONE_CONFIG=/etc/werewolf/rclone.conf
